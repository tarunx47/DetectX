# ==============================================================================
# DetectX Root Environment Configuration Example
# Copy this file to .env for local configuration (do NOT commit secrets)
# ==============================================================================

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# Additional Allowed Origins for CORS (comma-separated)
# In production on Render, set this to your Vercel deployment URL
ADDITIONAL_CORS_ORIGINS=https://detectx.vercel.app,https://your-app.vercel.app

# Frontend API Base URL (used when building frontend)
VITE_API_BASE_URL=http://localhost:8000
